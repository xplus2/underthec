#include <windows.h>

#include "../version.h"
#include "scr_res.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "scr.manifest"

1 ICON "../win/scr.ico"

STRINGTABLE
BEGIN
  IDS_DESCRIPTION TOOL_DISPLAY_NAME
END

IDD_CONFIG DIALOGEX 0, 0, 330, 254
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION TOOL_DISPLAY_NAME " screensaver"
FONT 8, "MS Shell Dlg"
BEGIN
  GROUPBOX "Aquatic life", -1, 7, 7, 316, 74
  LTEXT "Classic:", -1, 14, 20, 30, 8
  COMBOBOX IDC_CLASSIC, 46, 18, 50, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Fish:", -1, 120, 20, 20, 8
  EDITTEXT IDC_FISH, 142, 18, 36, 12, ES_NUMBER | ES_AUTOHSCROLL
  AUTOCHECKBOX "auto", IDC_FISH_AUTO, 184, 19, 40, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 0, 14, 36, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 1, 76, 36, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 2, 138, 36, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 3, 200, 36, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 4, 262, 36, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 5, 14, 48, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 6, 76, 48, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 7, 138, 48, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 8, 200, 48, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 9, 262, 48, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 10, 14, 60, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 11, 76, 60, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 12, 138, 60, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 13, 200, 60, 58, 10
  AUTOCHECKBOX "", IDC_FLAG0 + 14, 262, 60, 58, 10

  GROUPBOX "Message", -1, 7, 86, 316, 104
  EDITTEXT IDC_MESSAGE, 14, 98, 302, 64, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
  LTEXT "Color:", -1, 14, 172, 24, 8
  COMBOBOX IDC_MSG_COLOR, 40, 170, 70, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Position:", -1, 130, 172, 32, 8
  COMBOBOX IDC_MSG_POS, 164, 170, 70, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

  GROUPBOX "Motion", -1, 7, 195, 316, 30
  LTEXT "Pace:", -1, 14, 209, 22, 8
  EDITTEXT IDC_PACE, 38, 207, 36, 12, ES_AUTOHSCROLL
  LTEXT "FPS:", -1, 96, 209, 18, 8
  EDITTEXT IDC_FPS, 116, 207, 30, 12, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "U-turn chance, 1 in:", -1, 170, 209, 70, 8
  EDITTEXT IDC_UTURN, 242, 207, 40, 12, ES_NUMBER | ES_AUTOHSCROLL

  LTEXT "", IDC_VERSION, 7, 236, 100, 8
  PUSHBUTTON "Defaults", IDC_DEFAULTS, 160, 233, 50, 14
  DEFPUSHBUTTON "OK", IDOK, 216, 233, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 273, 233, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION TOOL_VERSION_MAJOR, TOOL_VERSION_MINOR, TOOL_VERSION_PATCH, 0
PRODUCTVERSION TOOL_VERSION_MAJOR, TOOL_VERSION_MINOR, TOOL_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", TOOL_DISPLAY_NAME " screensaver"
      VALUE "ProductName", TOOL_DISPLAY_NAME
      VALUE "ProductVersion", TOOL_VERSION
      VALUE "FileVersion", TOOL_VERSION
      VALUE "OriginalFilename", "underthec.scr"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
