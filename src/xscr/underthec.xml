<screensaver name="underthec" _label="Under The C">
  <_description>
Under The C - a C-port of Asciiquarium.
  </_description>
  <hgroup>
    <select id="mode">
      <option id="free" _label="off"/>
      <option id="classic10" _label="Classic 1.0" arg-set="--classic 1.0"/>
      <option id="classic11" _label="Classic 1.1" arg-set="--classic 1.1"/>
    </select>
  </hgroup>
  <hgroup>
    <string id="aquatic-life" arg="--aquatic-life %" _label="aquatic-life"/>
  </hgroup>
  <hgroup>
    <string id="message" arg="--message %" _label="Message"/>
  </hgroup>
  <hgroup>
    <select id="message-color">
      <option id="c-default" _label="(default)"/>
      <option id="c-black" _label="Black" arg-set="--message-color black"/>
      <option id="c-red" _label="Red" arg-set="--message-color red"/>
      <option id="c-green" _label="Green" arg-set="--message-color green"/>
      <option id="c-yellow" _label="Yellow" arg-set="--message-color yellow"/>
      <option id="c-blue" _label="Blue" arg-set="--message-color blue"/>
      <option id="c-magenta" _label="Magenta" arg-set="--message-color magenta"/>
      <option id="c-cyan" _label="Cyan" arg-set="--message-color cyan"/>
      <option id="c-white" _label="White" arg-set="--message-color white"/>
      <option id="c-Black" _label="Black (bold)" arg-set="--message-color Black"/>
      <option id="c-Red" _label="Red (bold)" arg-set="--message-color Red"/>
      <option id="c-Green" _label="Green (bold)" arg-set="--message-color Green"/>
      <option id="c-Yellow" _label="Yellow (bold)" arg-set="--message-color Yellow"/>
      <option id="c-Blue" _label="Blue (bold)" arg-set="--message-color Blue"/>
      <option id="c-Magenta" _label="Magenta (bold)" arg-set="--message-color Magenta"/>
      <option id="c-Cyan" _label="Cyan (bold)" arg-set="--message-color Cyan"/>
      <option id="c-White" _label="White (bold)" arg-set="--message-color White"/>
    </select>
    <select id="message-position">
      <option id="p-middle" _label="Middle" arg-set="--message-position middle"/>
      <option id="p-center" _label="Center" arg-set="--message-position center"/>
      <option id="p-marquee" _label="Marquee" arg-set="--message-position marquee"/>
      <option id="p-swim" _label="Swim" arg-set="--message-position swim"/>
      <option id="p-event" _label="Event" arg-set="--message-position event"/>
    </select>
  </hgroup>
  <hgroup>
    <string id="castle-name" arg="--castle-name %" _label="Castle name"/>
  </hgroup>
  <hgroup>
    <_label>Pace</_label>
    <number id="pace" type="slider" arg="--pace %" low="0.01" high="10" default="1.0"/>
  </hgroup>
  <hgroup>
    <_label>U-turn chance (1 in N, 0=never)</_label>
    <number id="uturn-chance" type="slider" arg="--uturn-chance %" low="0" high="2000" default="200"/>
  </hgroup>
  <hgroup>
    <_label>Frames per second</_label>
    <number id="fps" type="slider" arg="--fps %" low="1" high="120" default="10"/>
  </hgroup>
</screensaver>
